# DeepSeek API Key — https://platform.deepseek.com/api_keys
# Chave primária (padrão) para extração de comprovantes
DEEPSEEK_API_KEY=sk_sua_chave_aqui

# Groq API Key — https://console.groq.com/keys (opcional — usado como fallback)
# Crie uma chave gratuita no console da Groq e cole abaixo
# GROQ_API_KEY=gsk_sua_chave_aqui

# Lista de modelos para fallback (opcional — padrão: deepseek:deepseek-flash)
# Formato: provedor:modelo, separado por vírgulas, em ordem de prioridade.
# Provedores suportados: deepseek, groq
# Exemplo com fallback para Groq:
# MODEL_FALLBACK_LIST=deepseek:deepseek-flash,groq:qwen/qwen3.8-27b